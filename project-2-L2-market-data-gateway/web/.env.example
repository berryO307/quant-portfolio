# Relay endpoints, one relay per instrument (see lib/instruments.ts).
# Locally these default to ws://localhost:8080 (BTC) and :8085 (WTI / xyz:CL).
# On Vercel, set all four to the hosted relays (wss:// and https://, since
# the site is served over HTTPS and browsers block mixed content).
NEXT_PUBLIC_RELAY_WS_URL=ws://localhost:8080/live
NEXT_PUBLIC_RELAY_HEALTH_URL=http://localhost:8080/health
NEXT_PUBLIC_RELAY_CL_WS_URL=ws://localhost:8085/live
NEXT_PUBLIC_RELAY_CL_HEALTH_URL=http://localhost:8085/health
