# Relay endpoint for the FIRST instrument only (BTC/USDT via Bybit) — see
# lib/instruments.ts for the full instrument dropdown list. The other
# instruments use fixed localhost ports (8081-8087), not env-overridable;
# each needs its own `quant_day1.exe --source=<x> <symbol>` + relay pair
# running on its assigned port for its dropdown entry to show live data.
# See relay/src/index.ts for the defaults these fall back to locally.
NEXT_PUBLIC_RELAY_WS_URL=ws://localhost:8080/live
NEXT_PUBLIC_RELAY_HEALTH_URL=http://localhost:8080/health
