# Relay endpoints this app connects to directly from the browser.
# See relay/src/index.ts for the defaults these fall back to locally.
NEXT_PUBLIC_RELAY_WS_URL=ws://localhost:8080/live
NEXT_PUBLIC_RELAY_HEALTH_URL=http://localhost:8080/health

# Instrument the ticker's 24h-change figure is fetched for (Bybit public
# REST, unrelated to the relay feed) — must match whatever the C++ gateway
# is actually capturing.
NEXT_PUBLIC_TICKER_SYMBOL=BTCUSDT
